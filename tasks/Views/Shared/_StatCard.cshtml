@model StatCardViewModel
<div class="card p-5">
    <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
            <p class="text-[12px] font-medium text-slate-500">@Model.Label</p>
            <p class="mt-2 text-[26px] font-semibold leading-none tracking-[-0.03em] text-ink-900">@Model.Value</p>
        </div>
        <span class="stat-icon @DisplayHelpers.StatTone(Model.Tone)">
            <i data-lucide="@Model.Icon" class="h-[18px] w-[18px]"></i>
        </span>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Caption))
    {
        <p class="mt-3 truncate text-[11.5px] text-slate-500">@Model.Caption</p>
    }
</div>
