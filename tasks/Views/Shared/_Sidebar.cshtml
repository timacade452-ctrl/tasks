@{
    var profile = ViewBag.Profile as UserProfile ?? new UserProfile();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    var navSections = new[]
    {
        new
        {
            Section = "Overview",
            Items = new[]
            {
                new { Label = "Dashboard", Icon = "layout-dashboard", Url = "/Dashboard", Controller = "Dashboard" }
            }
        },
        new
        {
            Section = "Study",
            Items = new[]
            {
                new { Label = "My Courses", Icon = "book-open", Url = "/Courses", Controller = "Courses" },
                new { Label = "Study Materials", Icon = "folder-open", Url = "/Materials", Controller = "Materials" },
                new { Label = "All Tasks", Icon = "check-square-2", Url = "/Tasks", Controller = "Tasks" }
            }
        },
        new
        {
            Section = "Focus",
            Items = new[]
            {
                new { Label = "Pomodoro Timer", Icon = "timer", Url = "/Pomodoro", Controller = "Pomodoro" },
                new { Label = "Study Planner", Icon = "calendar-days", Url = "/Planner", Controller = "Planner" },
                new { Label = "Calendar", Icon = "calendar", Url = "/Calendar", Controller = "Calendar" }
            }
        },
        new
        {
            Section = "Insights",
            Items = new[]
            {
                new { Label = "Analytics", Icon = "bar-chart-3", Url = "/Analytics", Controller = "Analytics" }
            }
        }
    };

    bool IsActive(string name) => name.Equals(controller, StringComparison.OrdinalIgnoreCase);
}

<div class="flex h-full flex-col">
    <div class="flex h-16 shrink-0 items-center gap-3 px-5">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 text-white shadow-sm">
            <i data-lucide="graduation-cap" class="h-5 w-5"></i>
        </div>
        <div class="leading-tight">
            <p class="text-[15px] font-semibold tracking-[-0.01em] text-ink-900">StudyFlow</p>
            <p class="text-[11px] font-medium text-slate-400">Student workspace</p>
        </div>
    </div>

    <nav class="no-scrollbar flex-1 overflow-y-auto px-3 pb-4" aria-label="Main navigation">
        @foreach (var navGroup in navSections)
        {
            <p class="nav-section">@navGroup.Section</p>
            <div class="space-y-1">
                @foreach (var item in navGroup.Items)
                {
                    var active = IsActive(item.Controller);
                    <a href="@item.Url" class="nav-link @(active ? "nav-link-active" : "")" aria-current="@(active ? "page" : "false")">
                        <i data-lucide="@item.Icon" class="h-[18px] w-[18px] @(active ? "text-brand-600" : "text-slate-400")"></i>
                        <span>@item.Label</span>
                    </a>
                }
            </div>
        }

        <p class="nav-section">Account</p>
        <div class="space-y-1">
            <a href="/Settings" class="nav-link @(IsActive("Settings") ? "nav-link-active" : "")">
                <i data-lucide="settings-2" class="h-[18px] w-[18px] @(IsActive("Settings") ? "text-brand-600" : "text-slate-400")"></i>
                <span>Settings</span>
            </a>
            <a href="/Profile" class="nav-link @(IsActive("Profile") ? "nav-link-active" : "")">
                <i data-lucide="user-round" class="h-[18px] w-[18px] @(IsActive("Profile") ? "text-brand-600" : "text-slate-400")"></i>
                <span>Profile</span>
            </a>
        </div>
    </nav>

    <div class="shrink-0 border-t border-slate-100 p-3">
        <div class="rounded-xl bg-slate-50 p-3">
            <div class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-wide text-slate-500">
                <i data-lucide="database" class="h-3.5 w-3.5"></i>
                Demo workspace
            </div>
            <p class="mt-1.5 text-[11.5px] leading-relaxed text-slate-500">
                Data is stored in memory and resets when the app restarts.
            </p>
        </div>
        <a href="/Profile" class="mt-3 flex items-center gap-2.5 rounded-xl p-2 transition-colors hover:bg-slate-50">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white" style="background-color:@profile.AvatarColor">
                @profile.Initials
            </span>
            <span class="min-w-0 flex-1">
                <span class="block truncate text-[13px] font-semibold text-ink-900">@profile.FullName</span>
                <span class="block truncate text-[11px] text-slate-500">@profile.YearOfStudy</span>
            </span>
            <i data-lucide="chevrons-up-down" class="h-4 w-4 text-slate-300"></i>
        </a>
    </div>
</div>
