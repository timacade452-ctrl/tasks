@model StudyBarsViewModel
@{
    var max = Math.Max(30, Model.MaxMinutes);
    var barGap = Model.Compact ? "gap-1" : "gap-2";
}
<div>
    <div class="relative @(Model.Compact ? "h-20" : "h-44")">
        <div class="pointer-events-none absolute inset-0 flex flex-col justify-between">
            @for (var i = 0; i < 4; i++)
            {
                <span class="block border-t border-dashed border-slate-100"></span>
            }
        </div>
        <div class="relative flex h-full items-end @barGap">
            @foreach (var point in Model.Points)
            {
                var height = point.Minutes <= 0 ? 2 : Math.Max(5, (int)Math.Round(point.Minutes * 100d / max));
                var isToday = point.Date == DateTime.Today;
                var barClass = point.Minutes <= 0
                    ? "bg-slate-200"
                    : isToday ? "bg-brand-600" : "bg-brand-400/80";
                <div class="group relative flex h-full flex-1 items-end" title="@point.Label · @DisplayHelpers.MinutesLabel(point.Minutes)@(point.CompletedTasks > 0 ? $" · {point.CompletedTasks} task(s) done" : "")">
                    @if (Model.ShowValues && !Model.Compact && point.Minutes > 0)
                    {
                        <span class="absolute left-1/2 w-full -translate-x-1/2 text-center text-[9.5px] font-medium text-slate-400" style="bottom: calc(@(height)% + 6px)">@point.Minutes</span>
                    }
                    <div class="w-full rounded-t-md transition-colors @barClass group-hover:bg-brand-600" style="height:@(height)%"></div>
                </div>
            }
        </div>
    </div>
    <div class="mt-2 flex @barGap">
        @foreach (var point in Model.Points)
        {
            <div class="min-w-0 flex-1 text-center">
                <span class="block truncate @(point.Date == DateTime.Today ? "font-semibold text-brand-700" : "text-slate-400") @(Model.Compact ? "text-[9px]" : "text-[10.5px]")">@point.Label</span>
            </div>
        }
    </div>
</div>
