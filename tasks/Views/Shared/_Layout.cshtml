@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    var profile = ViewBag.Profile as UserProfile ?? new UserProfile();
    var alerts = ViewBag.Alerts as IReadOnlyList<NotificationItem> ?? Array.Empty<NotificationItem>();
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
    var title = ViewData["Title"] as string ?? "StudyFlow";
    var subtitle = ViewData["Subtitle"] as string;
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title · StudyFlow</title>
    <meta name="theme-color" content="#ffffff" />
    <meta name="csrf-token" content="@token" />
    <meta name="timer-focus" content="@profile.FocusMinutes" />
    <meta name="timer-short" content="@profile.ShortBreakMinutes" />
    <meta name="timer-long" content="@profile.LongBreakMinutes" />
    <meta name="timer-interval" content="@profile.LongBreakInterval" />
    <meta name="timer-sound" content="@(profile.SoundEnabled ? "true" : "false")" />
    <meta name="timer-autostart" content="@(profile.AutoStartBreaks ? "true" : "false")" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-full">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:shadow-pop">
        Skip to content
    </a>

    <div id="sidebarOverlay" class="fixed inset-0 z-40 hidden bg-ink-950/40 backdrop-blur-[1px] lg:hidden"></div>

    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-[264px] -translate-x-full border-r border-slate-200 bg-white transition-transform duration-200 ease-out lg:translate-x-0">
        <partial name="_Sidebar" />
    </aside>

    <div class="flex min-h-screen flex-col lg:pl-[264px]">
        <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/80">
            <div class="flex h-16 items-center gap-3 px-4 sm:px-6 lg:px-8">
                <button type="button" id="sidebarToggle" class="icon-btn lg:hidden" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false">
                    <i data-lucide="menu" class="h-5 w-5"></i>
                </button>

                <div class="hidden min-w-0 items-center gap-2 text-sm sm:flex">
                    <a href="/Dashboard" class="text-slate-400 transition-colors hover:text-slate-600">StudyFlow</a>
                    <i data-lucide="chevron-right" class="h-3.5 w-3.5 text-slate-300"></i>
                    <span class="truncate font-medium text-ink-900">@title</span>
                </div>

                <div class="ml-auto flex items-center gap-1.5 sm:gap-2">
                    <a href="/Pomodoro" id="miniTimer" class="hidden h-9 items-center gap-2 rounded-lg border border-slate-200 bg-white px-2.5 text-xs font-medium text-ink-900 shadow-sm transition-colors hover:border-brand-200 hover:bg-brand-50/40">
                        <span id="miniTimerDot" class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
                        <span id="miniTimerPhase" class="hidden text-slate-500 sm:inline">Focus</span>
                        <span id="miniTimerTime" class="tabular-nums">25:00</span>
                    </a>

                    <span class="hidden items-center gap-1.5 rounded-lg px-2.5 py-2 text-xs font-medium text-slate-500 lg:flex">
                        <i data-lucide="calendar-days" class="h-4 w-4 text-slate-400"></i>
                        @(ViewBag.TodayLabel ?? DateTime.Today.ToString("dddd, MMMM d"))
                    </span>

                    <div class="relative" data-dropdown-root>
                        <button type="button" class="btn btn-primary btn-sm hidden sm:inline-flex" data-dropdown-trigger aria-expanded="false" aria-haspopup="true">
                            <i data-lucide="plus" class="h-4 w-4"></i>
                            Quick add
                        </button>
                        <button type="button" class="icon-btn sm:hidden" data-dropdown-trigger aria-label="Quick add" aria-expanded="false" aria-haspopup="true">
                            <i data-lucide="plus" class="h-5 w-5"></i>
                        </button>
                        <div class="dropdown" data-dropdown-menu>
                            <p class="px-3 pb-1 pt-2 text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-400">Create</p>
                            <a href="/Tasks/Create" class="menu-item">
                                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600"><i data-lucide="check-square-2" class="h-4 w-4"></i></span>
                                <span><span class="block font-medium">New task</span><span class="block text-xs text-slate-500">Assignment, reading or revision</span></span>
                            </a>
                            <a href="/Materials/Upload" class="menu-item">
                                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-50 text-sky-600"><i data-lucide="upload" class="h-4 w-4"></i></span>
                                <span><span class="block font-medium">Upload material</span><span class="block text-xs text-slate-500">PDF, Word or PowerPoint</span></span>
                            </a>
                            <a href="/Planner" class="menu-item">
                                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50 text-amber-600"><i data-lucide="calendar-plus" class="h-4 w-4"></i></span>
                                <span><span class="block font-medium">Plan a study block</span><span class="block text-xs text-slate-500">Block time in your calendar</span></span>
                            </a>
                            <a href="/Courses/Create" class="menu-item">
                                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600"><i data-lucide="book-plus" class="h-4 w-4"></i></span>
                                <span><span class="block font-medium">Add a course</span><span class="block text-xs text-slate-500">Group tasks and materials</span></span>
                            </a>
                        </div>
                    </div>

                    <div class="relative" data-dropdown-root>
                        <button type="button" class="icon-btn relative" data-dropdown-trigger aria-label="Notifications" aria-expanded="false" aria-haspopup="true">
                            <i data-lucide="bell" class="h-5 w-5"></i>
                            @if (alerts.Count > 0)
                            {
                                <span class="absolute right-1.5 top-1.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-brand-600 px-1 text-[9px] font-semibold text-white">@alerts.Count</span>
                            }
                        </button>
                        <div class="dropdown w-[320px]" data-dropdown-menu>
                            <div class="flex items-center justify-between px-3 py-2">
                                <p class="text-sm font-semibold">Notifications</p>
                                <a href="/Tasks" class="text-[11px] font-medium text-brand-600 hover:text-brand-700">View tasks</a>
                            </div>
                            <div class="max-h-80 overflow-y-auto">
                                @if (alerts.Count == 0)
                                {
                                    <div class="flex flex-col items-center gap-1 px-4 py-8 text-center">
                                        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-50 text-emerald-600"><i data-lucide="check" class="h-4 w-4"></i></span>
                                        <p class="text-sm font-medium text-ink-900">You're all caught up</p>
                                        <p class="text-xs text-slate-500">No overdue or soon-due tasks.</p>
                                    </div>
                                }
                                else
                                {
                                    foreach (var alert in alerts)
                                    {
                                        var tone = alert.Tone switch
                                        {
                                            "rose" => "bg-rose-50 text-rose-600",
                                            "amber" => "bg-amber-50 text-amber-600",
                                            _ => "bg-brand-50 text-brand-600"
                                        };
                                        <a href="@alert.Url" class="flex items-start gap-3 rounded-lg px-3 py-2.5 transition-colors hover:bg-slate-50">
                                            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg @tone"><i data-lucide="@alert.Icon" class="h-4 w-4"></i></span>
                                            <span class="min-w-0">
                                                <span class="block text-[12.5px] font-semibold text-ink-900">@alert.Title</span>
                                                <span class="mt-0.5 block truncate text-[11.5px] text-slate-500">@alert.Detail</span>
                                            </span>
                                        </a>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="relative" data-dropdown-root>
                        <button type="button" class="flex h-9 items-center gap-2 rounded-full pl-1 pr-1.5 transition-colors hover:bg-slate-100" data-dropdown-trigger aria-expanded="false" aria-haspopup="true" aria-label="Account menu">
                            <span class="flex h-8 w-8 items-center justify-center rounded-full text-[11px] font-semibold text-white" style="background-color:@profile.AvatarColor">@profile.Initials</span>
                            <i data-lucide="chevron-down" class="hidden h-3.5 w-3.5 text-slate-400 sm:block"></i>
                        </button>
                        <div class="dropdown w-60" data-dropdown-menu>
                            <div class="border-b border-slate-100 px-3 pb-2.5 pt-2">
                                <p class="truncate text-sm font-semibold text-ink-900">@profile.FullName</p>
                                <p class="truncate text-[11px] text-slate-500">@profile.Email</p>
                            </div>
                            <div class="py-1">
                                <a href="/Profile" class="menu-item"><i data-lucide="user-round" class="h-4 w-4 text-slate-400"></i>Your profile</a>
                                <a href="/Settings" class="menu-item"><i data-lucide="settings-2" class="h-4 w-4 text-slate-400"></i>Settings</a>
                                <a href="/Analytics" class="menu-item"><i data-lucide="bar-chart-3" class="h-4 w-4 text-slate-400"></i>Study analytics</a>
                            </div>
                            <div class="mt-1 rounded-lg bg-slate-50 px-3 py-2">
                                <p class="text-[10.5px] leading-relaxed text-slate-500">Demo account · data resets when the app restarts.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <main id="main-content" class="mx-auto w-full max-w-[1440px] flex-1 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
            <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div class="min-w-0">
                    <h1 class="text-[22px] font-semibold tracking-[-0.02em] text-ink-900 sm:text-[26px]">@title</h1>
                    @if (!string.IsNullOrWhiteSpace(subtitle))
                    {
                        <p class="mt-1 text-[13.5px] text-slate-500">@subtitle</p>
                    }
                </div>
                @if (IsSectionDefined("PageActions"))
                {
                    <div class="flex flex-wrap items-center gap-2">
                        @await RenderSectionAsync("PageActions", required: false)
                    </div>
                }
            </div>

            @RenderBody()
        </main>
    </div>

    <div id="toastStack" class="fixed bottom-4 right-4 z-[120] flex w-[min(92vw,380px)] flex-col gap-2" aria-live="polite">
        @if (!string.IsNullOrWhiteSpace(success))
        {
            <div class="pointer-events-auto flex items-start gap-3 rounded-xl border border-emerald-200 bg-white p-3.5 shadow-pop" data-toast>
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600"><i data-lucide="check-circle-2" class="h-4 w-4"></i></span>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-semibold text-ink-900">Done</p>
                    <p class="mt-0.5 text-xs leading-relaxed text-slate-600">@success</p>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600" data-toast-close aria-label="Dismiss"><i data-lucide="x" class="h-4 w-4"></i></button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="pointer-events-auto flex items-start gap-3 rounded-xl border border-rose-200 bg-white p-3.5 shadow-pop" data-toast>
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-rose-50 text-rose-600"><i data-lucide="alert-circle" class="h-4 w-4"></i></span>
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-semibold text-ink-900">Something needs attention</p>
                    <p class="mt-0.5 text-xs leading-relaxed text-slate-600">@error</p>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600" data-toast-close aria-label="Dismiss"><i data-lucide="x" class="h-4 w-4"></i></button>
            </div>
        }
    </div>

    <div id="confirmDialog" class="fixed inset-0 z-[130] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
        <div class="absolute inset-0 bg-ink-950/45" data-confirm-cancel></div>
        <div class="relative w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-pop">
            <div class="flex items-start gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-rose-50 text-rose-600"><i data-lucide="alert-triangle" class="h-5 w-5"></i></span>
                <div class="min-w-0">
                    <h2 id="confirmTitle" class="text-base font-semibold text-ink-900">Are you sure?</h2>
                    <p id="confirmMessage" class="mt-1.5 text-sm leading-relaxed text-slate-600">This action cannot be undone.</p>
                </div>
            </div>
            <div class="mt-6 flex justify-end gap-2">
                <button type="button" class="btn btn-secondary" data-confirm-cancel>Cancel</button>
                <button type="button" class="btn btn-danger" data-confirm-ok>Delete</button>
            </div>
        </div>
    </div>

    <script src="~/lib/lucide/lucide.min.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/pomodoro.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
