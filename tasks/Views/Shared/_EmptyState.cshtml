@model EmptyStateViewModel
<div class="empty-state">
    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-slate-400 ring-1 ring-slate-200">
        <i data-lucide="@Model.Icon" class="h-5 w-5"></i>
    </span>
    <p class="mt-3 text-sm font-semibold text-ink-900">@Model.Title</p>
    <p class="mt-1 max-w-sm text-xs leading-relaxed text-slate-500">@Model.Text</p>
    @if (!string.IsNullOrWhiteSpace(Model.ActionUrl) && !string.IsNullOrWhiteSpace(Model.ActionLabel))
    {
        <a href="@Model.ActionUrl" class="btn btn-secondary btn-sm mt-4">@Model.ActionLabel</a>
    }
</div>
