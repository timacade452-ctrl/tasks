@model CoursesIndexViewModel

@section PageActions {
    <a href="/Courses/Create" class="btn btn-primary btn-sm sm:h-10">
        <i data-lucide="plus" class="h-4 w-4"></i>
        Add course
    </a>
}

<div class="space-y-5">
    <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        @await Html.PartialAsync("_StatCard", new StatCardViewModel
        {
            Label = "Active courses",
            Value = Model.Courses.Count.ToString(),
            Caption = Model.Courses.Count == 1 ? "This semester" : "Across this semester",
            Icon = "book-open",
            Tone = "brand"
        })
        @await Html.PartialAsync("_StatCard", new StatCardViewModel
        {
            Label = "Study materials",
            Value = Model.TotalMaterials.ToString(),
            Caption = "Files in your library",
            Icon = "folder-open",
            Tone = "sky"
        })
        @await Html.PartialAsync("_StatCard", new StatCardViewModel
        {
            Label = "Open tasks",
            Value = Model.OpenTasks.ToString(),
            Caption = $"{Model.CompletedTasks} completed",
            Icon = "check-square-2",
            Tone = "amber"
        })
        @await Html.PartialAsync("_StatCard", new StatCardViewModel
        {
            Label = "Focus time",
            Value = $"{DisplayHelpers.Hours(Model.FocusMinutes):0.#} hr",
            Caption = "Logged across all courses",
            Icon = "clock-3",
            Tone = "emerald"
        })
    </div>

    @if (Model.Courses.Count == 0)
    {
        <div class="card p-5">
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
            {
                Icon = "book-plus",
                Title = "Add your first course",
                Text = "Courses keep materials, deadlines and study plans together. It takes about a minute to set one up.",
                ActionUrl = "/Courses/Create",
                ActionLabel = "Create a course"
            })
        </div>
    }
    else
    {
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            @foreach (var summary in Model.Courses)
            {
                var course = summary.Course;
                <article class="card flex flex-col overflow-hidden transition-shadow hover:shadow-pop">
                    <div class="h-1.5 w-full" style="background-color:@course.Color"></div>
                    <div class="flex flex-1 flex-col p-5">
                        <div class="flex items-start gap-3">
                            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-white shadow-sm" style="background-color:@course.Color">
                                <i data-lucide="@course.Icon" class="h-5 w-5"></i>
                            </span>
                            <div class="min-w-0 flex-1">
                                <p class="text-[11px] font-semibold uppercase tracking-[0.08em]" style="color:@course.Color">@course.Code</p>
                                <a href="/Courses/Details/@course.Id" class="mt-0.5 block truncate text-[15px] font-semibold text-ink-900 hover:text-brand-700">@course.Name</a>
                                <p class="mt-0.5 truncate text-[11.5px] text-slate-500">@course.Instructor</p>
                            </div>
                            <a href="/Courses/Edit/@course.Id" class="icon-btn -mr-1 -mt-1 shrink-0" aria-label="Edit @course.Code" title="Edit course">
                                <i data-lucide="pencil" class="h-4 w-4"></i>
                            </a>
                        </div>

                        <div class="mt-3 flex flex-wrap items-center gap-1.5">
                            <span class="chip bg-slate-50 text-slate-600 ring-slate-200">
                                <i data-lucide="calendar-range" class="h-3 w-3"></i>
                                @course.Semester
                            </span>
                            @if (!string.IsNullOrWhiteSpace(course.Description))
                            {
                                <span class="chip bg-white text-slate-500 ring-slate-200">@course.Description.Length chars</span>
                            }
                        </div>

                        <p class="mt-3 line-clamp-2 min-h-[2.4rem] text-[12.5px] leading-relaxed text-slate-500">
                            @(string.IsNullOrWhiteSpace(course.Description) ? "No description yet — add one from the edit page." : course.Description)
                        </p>

                        <div class="mt-4 grid grid-cols-3 gap-2 rounded-xl bg-slate-50 p-2.5 text-center">
                            <div>
                                <p class="text-[15px] font-semibold leading-none text-ink-900">@summary.MaterialsCount</p>
                                <p class="mt-1 text-[10px] font-medium text-slate-500">Materials</p>
                            </div>
                            <div class="border-x border-slate-200">
                                <p class="text-[15px] font-semibold leading-none text-ink-900">@summary.OpenTasks</p>
                                <p class="mt-1 text-[10px] font-medium text-slate-500">Open tasks</p>
                            </div>
                            <div>
                                <p class="text-[15px] font-semibold leading-none text-ink-900">@DisplayHelpers.Hours(summary.FocusMinutes)<span class="text-[10px] font-medium text-slate-400">h</span></p>
                                <p class="mt-1 text-[10px] font-medium text-slate-500">Focus</p>
                            </div>
                        </div>

                        <div class="mt-4">
                            <div class="flex items-center justify-between text-[11px]">
                                <span class="font-medium text-slate-500">Task progress</span>
                                <span class="font-semibold text-ink-900">@summary.TaskProgress%</span>
                            </div>
                            <div class="progress mt-1.5">
                                <span style="width:@(summary.TaskProgress)%;background-color:@course.Color"></span>
                            </div>
                            <p class="mt-1.5 text-[10.5px] text-slate-400">@summary.CompletedTasks of @summary.TotalTasks tasks completed</p>
                        </div>

                        <div class="mt-4 flex items-center gap-2 border-t border-slate-100 pt-4">
                            <a href="/Courses/Details/@course.Id" class="btn btn-secondary btn-sm flex-1">
                                Open course
                                <i data-lucide="arrow-right" class="h-3.5 w-3.5"></i>
                            </a>
                            <a href="/Tasks/Create?courseId=@course.Id" class="icon-btn border border-slate-200" aria-label="Add task to @course.Code" title="Add task">
                                <i data-lucide="plus" class="h-4 w-4"></i>
                            </a>
                            <a href="/Pomodoro?courseId=@course.Id" class="icon-btn border border-slate-200" aria-label="Start focus for @course.Code" title="Start focus">
                                <i data-lucide="play" class="h-4 w-4"></i>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>
