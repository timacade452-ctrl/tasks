@model TaskDetailsViewModel
@{
    var task = Model.Task;
    var done = task.Status == AcademicTaskStatus.Completed;
    var focusUrl = Model.Course is null
        ? $"/Pomodoro?taskId={task.Id}"
        : $"/Pomodoro?courseId={Model.Course.Id}&taskId={task.Id}";
    var loggedPercent = DisplayHelpers.Percent(Model.FocusMinutes, task.EstimatedMinutes);
}

@section PageActions {
    <a href="/Tasks" class="btn btn-secondary btn-sm sm:h-10">
        <i data-lucide="arrow-left" class="h-4 w-4"></i>
        All tasks
    </a>
    <a href="@focusUrl" class="btn btn-primary btn-sm sm:h-10">
        <i data-lucide="play" class="h-4 w-4"></i>
        Focus on this
    </a>
}

<div class="space-y-5">
    <section class="card card-pad">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
            <div class="flex min-w-0 gap-3.5">
                <form method="post" asp-controller="Tasks" asp-action="ToggleComplete" asp-route-id="@task.Id" class="shrink-0 pt-1">
                    <button type="submit" class="flex h-6 w-6 items-center justify-center rounded-[7px] border transition-colors @(done ? "border-emerald-500 bg-emerald-500 text-white" : "border-slate-300 text-transparent hover:border-brand-500 hover:text-brand-200")" aria-label="@(done ? "Reopen task" : "Mark task complete")" title="@(done ? "Reopen" : "Mark complete")">
                        <i data-lucide="check" class="h-3.5 w-3.5"></i>
                    </button>
                </form>
                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="chip @DisplayHelpers.StatusBadge(task.Status)">@task.Status.DisplayName()</span>
                        <span class="chip @DisplayHelpers.PriorityBadge(task.Priority)">@task.Priority.DisplayName() priority</span>
                        <span class="chip @DisplayHelpers.TypeBadge(task.Type)">@task.Type.DisplayName()</span>
                    </div>
                    <h2 class="mt-2.5 text-[22px] font-semibold leading-tight tracking-[-0.02em] @(done ? "text-slate-400 line-through" : "text-ink-900")">@task.Title</h2>
                    <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1.5 text-[12px] text-slate-500">
                        @if (Model.Course is not null)
                        {
                            <a href="/Courses/Details/@Model.Course.Id" class="inline-flex items-center gap-1.5 font-medium text-slate-600 hover:text-brand-700">
                                <span class="h-2 w-2 rounded-full" style="background-color:@Model.Course.Color"></span>
                                @Model.Course.Code · @Model.Course.Name
                            </a>
                            <span class="text-slate-300">·</span>
                        }
                        <span class="font-medium @(done ? "text-slate-400" : task.IsOverdue ? "text-rose-600" : task.IsDueToday ? "text-amber-600" : "")">@DisplayHelpers.DueLabel(task.DueDate)</span>
                        <span class="text-slate-300">·</span>
                        <span>@task.DueDate.ToString("dddd, MMMM d, yyyy", CultureInfo.InvariantCulture)</span>
                    </div>
                </div>
            </div>

            <div class="flex shrink-0 flex-wrap items-center gap-2">
                <a href="/Tasks/Edit/@task.Id" class="btn btn-secondary btn-sm">
                    <i data-lucide="pencil" class="h-3.5 w-3.5"></i>
                    Edit
                </a>
                <form method="post" asp-controller="Tasks" asp-action="Delete" asp-route-id="@task.Id" asp-route-returnUrl="/Tasks"
                      data-confirm="Delete “@task.Title”? This cannot be undone.">
                    <button type="submit" class="btn btn-danger-soft btn-sm">
                        <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
                        Delete
                    </button>
                </form>
            </div>
        </div>

        <div class="mt-6 grid grid-cols-2 gap-3 border-t border-slate-100 pt-5 sm:grid-cols-4">
            <div class="rounded-xl bg-slate-50 px-3 py-2.5">
                <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Starts</p>
                <p class="mt-1 text-[12.5px] font-semibold text-ink-900">@DisplayHelpers.FriendlyDate(task.StartDate)</p>
            </div>
            <div class="rounded-xl bg-slate-50 px-3 py-2.5">
                <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Due</p>
                <p class="mt-1 text-[12.5px] font-semibold text-ink-900">@DisplayHelpers.FriendlyDate(task.DueDate)</p>
            </div>
            <div class="rounded-xl bg-slate-50 px-3 py-2.5">
                <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Estimate</p>
                <p class="mt-1 text-[12.5px] font-semibold text-ink-900">@DisplayHelpers.MinutesLabel(task.EstimatedMinutes)</p>
            </div>
            <div class="rounded-xl bg-slate-50 px-3 py-2.5">
                <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Focus logged</p>
                <p class="mt-1 text-[12.5px] font-semibold text-ink-900">@DisplayHelpers.MinutesLabel(Model.FocusMinutes)</p>
            </div>
        </div>
    </section>

    <div class="grid gap-5 xl:grid-cols-3">
        <div class="space-y-5 xl:col-span-2">
            <section class="card card-pad">
                <div class="flex items-center gap-2">
                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-50 text-brand-600"><i data-lucide="align-left" class="h-4 w-4"></i></span>
                    <h2 class="text-[15px] font-semibold text-ink-900">Description</h2>
                </div>
                @if (!string.IsNullOrWhiteSpace(task.Description))
                {
                    <p class="mt-4 whitespace-pre-line text-[13px] leading-relaxed text-slate-600">@task.Description</p>
                }
                else
                {
                    <p class="mt-4 rounded-xl border border-dashed border-slate-200 bg-slate-50/60 px-4 py-5 text-center text-[12.5px] text-slate-500">
                        No description yet. Add notes from the <a href="/Tasks/Edit/@task.Id" class="font-medium text-brand-600 hover:text-brand-700">edit page</a>.
                    </p>
                }
            </section>

            <section class="card">
                <div class="card-header">
                    <div>
                        <p class="text-[15px] font-semibold text-ink-900">Focus sessions</p>
                        <p class="mt-0.5 text-xs text-slate-500">@Model.FocusSessions session@(Model.FocusSessions == 1 ? "" : "s") logged against this task</p>
                    </div>
                    <a href="@focusUrl" class="btn btn-secondary btn-sm">
                        <i data-lucide="timer" class="h-3.5 w-3.5"></i>
                        Start
                    </a>
                </div>

                <div class="card-pad border-b border-slate-100">
                    <div class="flex items-center justify-between text-[11.5px]">
                        <span class="font-medium text-slate-500">Progress against estimate</span>
                        <span class="font-semibold text-ink-900">@loggedPercent%</span>
                    </div>
                    <div class="progress mt-2">
                        <span style="width:@(Math.Min(100, loggedPercent))%"></span>
                    </div>
                    <p class="mt-1.5 text-[11px] text-slate-400">@DisplayHelpers.MinutesLabel(Model.FocusMinutes) focused of @DisplayHelpers.MinutesLabel(task.EstimatedMinutes) estimated</p>
                </div>

                @if (Model.Sessions.Count == 0)
                {
                    <div class="p-5">
                        @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
                        {
                            Icon = "timer",
                            Title = "No focus time yet",
                            Text = "Start a Pomodoro session with this task selected and completed minutes will show up here.",
                            ActionUrl = focusUrl,
                            ActionLabel = "Start a focus session"
                        })
                    </div>
                }
                else
                {
                    <div class="divide-y divide-slate-100">
                        @foreach (var session in Model.Sessions)
                        {
                            <div class="flex items-center gap-3 px-5 py-3">
                                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600"><i data-lucide="timer" class="h-3.5 w-3.5"></i></span>
                                <div class="min-w-0 flex-1">
                                    <p class="text-[12.5px] font-medium text-ink-900">@session.DurationMinutes minute focus session</p>
                                    <p class="mt-0.5 text-[11px] text-slate-500">@DisplayHelpers.DateTimeLabel(session.CompletedAt)</p>
                                </div>
                                <span class="chip bg-emerald-50 text-emerald-700 ring-emerald-200">Completed</span>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>

        <aside class="space-y-5">
            <section class="card card-pad">
                <h2 class="text-[13.5px] font-semibold text-ink-900">Task details</h2>
                <dl class="mt-4 space-y-3 text-[12px]">
                    <div class="flex items-start justify-between gap-3">
                        <dt class="text-slate-500">Status</dt>
                        <dd><span class="chip py-0.5 @DisplayHelpers.StatusBadge(task.Status)">@task.Status.DisplayName()</span></dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                        <dt class="text-slate-500">Priority</dt>
                        <dd><span class="chip py-0.5 @DisplayHelpers.PriorityBadge(task.Priority)">@task.Priority.DisplayName()</span></dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                        <dt class="text-slate-500">Type</dt>
                        <dd class="text-right font-medium text-ink-900">@task.Type.DisplayName()</dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                        <dt class="text-slate-500">Created</dt>
                        <dd class="text-right font-medium text-ink-900">@DisplayHelpers.FriendlyDate(task.CreatedAt.ToLocalTime())</dd>
                    </div>
                    @if (task.CompletedAt.HasValue)
                    {
                        <div class="flex items-start justify-between gap-3">
                            <dt class="text-slate-500">Completed</dt>
                            <dd class="text-right font-medium text-emerald-600">@DisplayHelpers.DateTimeLabel(task.CompletedAt.Value)</dd>
                        </div>
                    }
                </dl>

                <form method="post" asp-controller="Tasks" asp-action="UpdateStatus" asp-route-id="@task.Id" class="mt-4 border-t border-slate-100 pt-4">
                    <label for="quickStatus" class="label">Quick status change</label>
                    <div class="flex gap-2">
                        <select id="quickStatus" name="status" class="select flex-1">
                            @foreach (var status in Enum.GetValues<AcademicTaskStatus>())
                            {
                                <option value="@status" selected="@(task.Status == status ? "selected" : null)">@status.DisplayName()</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-secondary">Update</button>
                    </div>
                </form>
            </section>

            @if (Model.Course is not null)
            {
                <section class="card card-pad">
                    <h2 class="text-[13.5px] font-semibold text-ink-900">Course</h2>
                    <a href="/Courses/Details/@Model.Course.Id" class="mt-3 flex items-center gap-3 rounded-xl border border-slate-200 p-3 transition-colors hover:border-slate-300 hover:bg-slate-50">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-white" style="background-color:@Model.Course.Color">
                            <i data-lucide="@Model.Course.Icon" class="h-4 w-4"></i>
                        </span>
                        <span class="min-w-0 flex-1">
                            <span class="block text-[11px] font-semibold uppercase tracking-wide" style="color:@Model.Course.Color">@Model.Course.Code</span>
                            <span class="block truncate text-[12.5px] font-medium text-ink-900">@Model.Course.Name</span>
                        </span>
                        <i data-lucide="arrow-up-right" class="h-4 w-4 shrink-0 text-slate-300"></i>
                    </a>
                </section>
            }

            @if (Model.NextTask is not null)
            {
                <section class="card card-pad">
                    <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Up next</p>
                    <a href="/Tasks/Details/@Model.NextTask.Id" class="mt-2 block text-[13px] font-semibold text-ink-900 hover:text-brand-700">@Model.NextTask.Title</a>
                    <p class="mt-1 text-[11.5px] font-medium @(Model.NextTask.IsOverdue ? "text-rose-600" : "text-slate-500")">@DisplayHelpers.DueLabel(Model.NextTask.DueDate)</p>
                    <a href="/Tasks/Details/@Model.NextTask.Id" class="mt-3 inline-flex items-center gap-1 text-[11.5px] font-medium text-brand-600 hover:text-brand-700">
                        Open task <i data-lucide="arrow-right" class="h-3 w-3"></i>
                    </a>
                </section>
            }
        </aside>
    </div>
</div>
